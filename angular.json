{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "visual-regression": {
      "projectType": "application",
      "root": "visual-regression/app",
      "sourceRoot": "visual-regression/app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/visual-regression",
            "browser": "visual-regression/app/main.ts",
            "index": "visual-regression/app/index.html",
            "tsConfig": "visual-regression/app/tsconfig.app.json",
            "styles": ["src/web/design-system/foundations/tailwind.css", "visual-regression/app/styles.css"]
          }
        },
        "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "visual-regression:build" } }
      }
    }
  }
}
